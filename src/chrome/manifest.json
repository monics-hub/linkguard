{
  "manifest_version": 3,
  "name": "LinkGuard – Aviso anti‑phishing para tu correo",
  "short_name": "LinkGuard",
  "version": "1.0.0",
  "description": "Antes de abrir un enlace desde Gmail u Outlook muestra el dominio real, detecta imitaciones, textos engañosos, IPs y acortadores, y permite analizarlo con urlscan.io.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "platform/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["platform/platform.js", "common/content/bootstrap.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "LinkGuard",
    "default_popup": "common/popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": { "page": "common/options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
